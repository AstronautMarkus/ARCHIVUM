# Copy to .env. Real environment variables win over this file.

# Empty in dev: a random key is kept in server/.secret. Set it in production.
SECRET_KEY=
MONGO_URL=mongodb://localhost:27017/archivum
# Empty: server/uploads
UPLOADS_DIR=
# Comma separated origins of a client hosted apart from Flask (its VITE_API_URL points here)
CORS_ORIGINS=
