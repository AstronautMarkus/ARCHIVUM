# Copy to .env.local (not committed). Only VITE_* variables reach the browser.

# Where `npm run dev` forwards /api, /files and /ws
API_PROXY=http://127.0.0.1:8000
# Empty: the API is on the same origin as the page. Set it only if the client is hosted
# apart from Flask, and list this client's origin in the server's CORS_ORIGINS
VITE_API_URL=
